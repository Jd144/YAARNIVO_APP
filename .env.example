# ==============================================================================
# YAARNIVO ENVIRONMENT CONFIGURATION (.env.example)
# India-focused 18+ Friendship & Social-Entertainment Platform
# Tagline: "Har Baat Se Bane Yaari" / "हर बात से बने यारी"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME (Required)
# ------------------------------------------------------------------------------
# App hosting URL
APP_URL="http://localhost:3000"

# Supabase Project URL & Anon Key (Required for persistent Auth, Email OTP, and DB)
# In development, the app also has an automatic transactional memory fallback if these are not yet supplied.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"

# ------------------------------------------------------------------------------
# 2. OPTIONAL: AGORA RTC (Audio & Video Calls) - Future Integration
# Note: Not required to run the app, onboarding, discovery, matching, or free chat.
# ------------------------------------------------------------------------------
# AGORA_APP_ID="your_agora_app_id"
# AGORA_APP_CERTIFICATE="your_agora_app_certificate"

# ------------------------------------------------------------------------------
# 3. OPTIONAL: BREVO SMTP (Custom SMTP for Supabase Email OTP)
# Configured in Supabase Dashboard -> Authentication -> Settings -> Custom SMTP
# Host: smtp-relay.brevo.com | Port: 587
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 4. OPTIONAL: RAZORPAY (Live INR Coin Purchases) - Future Integration
# Note: Not required for local coin wallet exploration or free chat.
# ------------------------------------------------------------------------------
# RAZORPAY_KEY_ID="rzp_test_your_key_id"
# RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# ------------------------------------------------------------------------------
# 5. OPTIONAL: CREATOR UPI PAYOUTS - Future Integration
# ------------------------------------------------------------------------------
# PAYOUT_PROVIDER_API_KEY="your-payout-api-key"
# PAYOUT_PROVIDER_SECRET="your-payout-secret"
